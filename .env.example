# =================================================================
# Vidjs - Night Experience OS | Variables de Entorno de Producción
# Copia este archivo como .env o configura estas variables en tu panel
# de hosting (Vercel, Railway, Render, AWS o VPS).
# =================================================================

# -----------------------------------------------------------------
# 1. Base de Datos (Prisma ORM)
# -----------------------------------------------------------------
# Para PostgreSQL (Docker, Supabase, Neon, AWS RDS):
DATABASE_URL="postgresql://vidjs_user:vidjs_secure_password@localhost:5432/vidjs_production?schema=public"

# Para SQLite local (desarrollo):
# DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# 2. Seguridad & Autenticación (JWT & Sesiones)
# -----------------------------------------------------------------
# Genera una clave segura con: openssl rand -base64 32
JWT_SECRET="reemplaza_con_un_string_aleatorio_seguro_de_al_menos_32_caracteres"

# Duración de la cookie de sesión en días (opcional, default 7)
SESSION_MAX_AGE_DAYS=7

# -----------------------------------------------------------------
# 3. Configuración del Servidor y Dominio Público
# -----------------------------------------------------------------
# URL pública canónica donde corre la aplicación (usado para QRs y redirects)
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://app.tu-bar.com"

# Puerto de escucha del servidor
PORT=3000

# Entorno de ejecución (production / development)
NODE_ENV="production"

# -----------------------------------------------------------------
# 4. Pasarela de Pagos (Opcional para Fast-Pass VIP & SaaS)
# -----------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
