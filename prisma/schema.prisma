datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Tenant (El Establecimiento cliente SaaS)
model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  status        String         @default("ACTIVE") // ACTIVE, SUSPENDED, TRIALING, CANCELLED
  logoUrl       String?
  settings      String?        // JSON string con configuraciones generales
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  venues        Venue[]
  events        Event[]
  tables        Table[]
  guestSessions GuestSession[]
  songRequests  SongRequest[]
  queueEntries  QueueEntry[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  photoPosts    PhotoPost[]
  karaokeContests KaraokeContest[]
  eventOrganizations   EventOrganization[]
  eventParticipants     EventParticipant[]
  accreditationTypes    AccreditationType[]
  eventAccreditations   EventAccreditation[]
  accessPoints          AccessPoint[]
  checkInRecords        CheckInRecord[]
  credentialTemplates   CredentialTemplate[]
  scannerDevices        ScannerDevice[]
  reservationPackages   ReservationPackage[]
  tableReservations     TableReservation[]

  // Relaciones Módulo Gestión Gastronómica
  gastroSectors         GastroSector[]
  gastroCategories      GastroCategory[]
  gastroProducts        GastroProduct[]
  gastroInventoryItems  GastroInventoryItem[]
  gastroMovements       GastroInventoryMovement[]
  gastroDeliveryConfigs GastroDeliveryConfig[]
  gastroTableSessions   GastroTableSession[]
  gastroOrders          GastroOrder[]
  gastroPayments        GastroPayment[]
  gastroDeposits        GastroCustomerDeposit[]
  gastroCashShifts      GastroCashRegisterShift[]
  gastroPendingSales    GastroPendingInvoiceSale[]

  @@index([status])
  @@index([slug])
}

// 2. User (Usuarios administrativos y operativos del sistema)
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  phone         String?
  role          String      @default("OPERATOR") // SUPER_ADMIN, OWNER, MANAGER, DJ, OPERATOR, GUEST, DISPLAY
  status        String      @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  tokenVersion  Int         @default(1)
  tenantId      String?     // Null para SUPER_ADMIN global
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  auditLogs     AuditLog[]

  @@index([tenantId])
  @@index([role])
  @@index([email])
}

// 3. Venue (Locales físicos o sucursales de un Tenant)
model Venue {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  address     String?
  phone       String?
  timezone    String      @default("UTC")
  active      Boolean     @default(true)
  settings    String?     // JSON string con branding y configuraciones específicas del local
  
  // Datos bancarios para transferencias directas y soporte WhatsApp
  bankName        String?
  bankAccount     String?
  bankHolder      String?
  bankTaxId       String?
  bankAlias       String?     // Alias SIPAP / PIX
  whatsappNumber  String?     // WhatsApp oficial para soporte y reservas

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  events              Event[]
  tables              Table[]
  reservationPackages ReservationPackage[]
  tableReservations   TableReservation[]

  // Relaciones Módulo Gestión Gastronómica
  gastroSectors         GastroSector[]
  gastroCategories      GastroCategory[]
  gastroProducts        GastroProduct[]
  gastroInventoryItems  GastroInventoryItem[]
  gastroMovements       GastroInventoryMovement[]
  gastroDeliveryConfig  GastroDeliveryConfig?
  gastroTableSessions   GastroTableSession[]
  gastroOrders          GastroOrder[]
  gastroPayments        GastroPayment[]
  gastroDeposits        GastroCustomerDeposit[]
  gastroCashShifts      GastroCashRegisterShift[]
  gastroPendingSales    GastroPendingInvoiceSale[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// 4. Event (Noches de fiesta, karaoke, sesiones en vivo)
model Event {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String?
  code        String         @unique // Código corto para acceso o display
  status      String         @default("DRAFT") // DRAFT, ACTIVE, PAUSED, FINISHED
  startsAt    DateTime
  endsAt      DateTime?
  pin         String?        // PIN de seguridad opcional para DJ o Display
  settings    String?        // JSON: límite de solicitudes por mesa, filtros, etc.
  
  // Datos extendidos para eventos profesionales y acreditación
  bannerUrl            String?
  logoUrl              String?
  eventType            String?        @default("GENERAL") // CONGRESO, CONFERENCIA, FERIA, FESTIVAL, CONCIERTO, EMPRESARIAL, PRIVADO, DEPORTIVO, FIESTA, GENERAL
  organizerName        String?
  responsibleCompany   String?
  companyRuc           String?
  locationName         String?
  address              String?
  timeSchedule         String?
  maxCapacity          Int?
  daysCount            Int?           @default(1)
  isPublicRegistration Boolean        @default(false)
  registrationFields   String?        // JSON string con campos requeridos y opcionales

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  guestSessions       GuestSession[]
  songRequests        SongRequest[]
  queueEntries        QueueEntry[]
  photoPosts          PhotoPost[]
  eventDays           EventDay[]
  accreditationTypes  AccreditationType[]
  organizations       EventOrganization[]
  participants        EventParticipant[]
  accreditations      EventAccreditation[]
  accessPoints        AccessPoint[]
  checkInRecords      CheckInRecord[]
  credentialTemplates CredentialTemplate[]
  scannerDevices      ScannerDevice[]
  reservations        TableReservation[]

  @@index([tenantId])
  @@index([venueId])
  @@index([status])
}

// 5. Table (Mesas o zonas del local con código QR individual)
model Table {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  number      Int
  label       String         // Ej: "Mesa 12", "VIP Terraza A"
  qrToken     String         @unique // Token único seguro codificado en el QR
  qrCodeUrl   String?        // URL de la imagen generada del QR
  capacity    Int            @default(4)
  zone        String         @default("MAIN") // MAIN, DJ, KARAOKE
  sectorId    String?
  sector      GastroSector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  tableStatus String         @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, PENDING_PAYMENT, CLEANING, BLOCKED
  posX        Int            @default(0)
  posY        Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  guestSessions       GuestSession[]
  songRequests        SongRequest[]
  photoPosts          PhotoPost[]
  reservations        TableReservation[]
  gastroTableSessions GastroTableSession[]
  gastroOrders        GastroOrder[]
  gastroDeposits      GastroCustomerDeposit[]

  @@unique([venueId, number])
  @@index([tenantId])
  @@index([venueId])
  @@index([qrToken])
  @@index([zone])
  @@index([sectorId])
  @@index([tableStatus])
}

// 6. GuestSession (Sesión del cliente tras escanear el QR)
model GuestSession {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId           String
  event             Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId           String
  table             Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionToken      String        @unique
  guestName         String?
  deviceFingerprint String?
  ipAddress         String?
  expiresAt         DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  songRequests      SongRequest[]

  @@index([tenantId])
  @@index([eventId])
  @@index([tableId])
  @@index([sessionToken])
}

// 7. Artist (Artistas del catálogo musical)
model Artist {
  id          String    @id @default(cuid())
  tenantId    String?   // null si es del catálogo global
  name        String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  songs       Song[]

  @@index([tenantId])
  @@index([name])
}

// 8. Song (Canciones disponibles en el catálogo de karaoke o DJ)
model Song {
  id              String        @id @default(cuid())
  tenantId        String?       // null si es del catálogo global
  artistId        String?
  artist          Artist?       @relation(fields: [artistId], references: [id], onDelete: SetNull)
  title           String
  durationSeconds Int           @default(0)
  genre           String?
  bpm             Int?
  key             String?
  fileUrl         String?
  isrc            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  songRequests    SongRequest[]

  @@index([tenantId])
  @@index([title])
  @@index([genre])
}

// 9. SongRequest (Peticiones de canciones enviadas por los clientes)
model SongRequest {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId         String
  table           Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestSessionId  String?
  guestSession    GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  songId          String?
  song            Song?         @relation(fields: [songId], references: [id], onDelete: SetNull)
  customTitle     String?
  customArtist    String?
  status          String        @default("PENDING") // PENDING, ACCEPTED, PLAYING, PLAYED, REJECTED, CANCELLED
  notes           String?       // Dedicatoria o mensaje del cliente
  tipAmountCents  Int           @default(0)
  playedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  queueEntry      QueueEntry?

  @@index([tenantId])
  @@index([eventId])
  @@index([tableId])
  @@index([status])
}

// 10. QueueEntry (Entrada en la cola de reproducción en vivo del DJ)
model QueueEntry {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId             String
  event               Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  songRequestId       String       @unique
  songRequest         SongRequest  @relation(fields: [songRequestId], references: [id], onDelete: Cascade)
  orderIndex          Int
  status              String       @default("QUEUED") // QUEUED, CURRENT, COMPLETED, SKIPPED
  estimatedStartTime  DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([status])
  @@index([orderIndex])
}

// 11. Plan (Planes comerciales del SaaS)
model Plan {
  id                String         @id @default(cuid())
  name              String
  code              String         @unique // STARTER, PRO, ENTERPRISE
  priceCents        Int
  currency          String         @default("USD")
  interval          String         @default("MONTHLY") // MONTHLY, YEARLY
  maxVenues         Int            @default(1)
  maxEventsPerMonth Int            @default(10)
  maxActiveTables   Int            @default(20)
  features          String?        // JSON array de características
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions     Subscription[]

  @@index([code])
  @@index([active])
}

// 12. Subscription (Suscripción comercial del Tenant)
model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("ACTIVE") // TRIALING, ACTIVE, PAST_DUE, CANCELED
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

// 13. AuditLog (Registro de auditoría inmutable para seguridad y trazabilidad)
model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String    // AUTH_LOGIN, VENUE_CREATE, EVENT_UPDATE, ROLE_ASSIGN, etc.
  resource   String    // AUTH, VENUE, EVENT, SUBSCRIPTION, etc.
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   String?   // JSON con detalles previos y posteriores
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// 14. PhotoPost (Muro social de fotos del local tomadas desde las mesas)
model PhotoPost {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestName String?
  imageUrl  String   // URL o Base64 Data URL
  caption   String?  // Mensaje o dedicatoria de la foto
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([status])
  @@index([tableId])
}

// 15. KaraokeContest (Concurso o Torneo de Karaoke Pro)
model KaraokeContest {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId          String?              // Opcional: vinculado a un evento o independiente
  name             String
  description      String?
  coverUrl         String?
  code             String               @unique // Código corto para display o acceso de jueces
  pin              String?              // PIN de acceso del DJ o jueces
  status           String               @default("DRAFT") // DRAFT, ACTIVE, PAUSED, FINISHED
  scoringMode      String               @default("AVERAGE") // AVERAGE, SUM, OLYMPIC, WEIGHTED
  publicVoteWeight Int                  @default(0) // 0% a 50%
  rules            String?              // Reglamento del certamen
  prizes           String?              // Premios 1er, 2do, 3er lugar (JSON o texto)
  logoUrl          String?              // Logo oficial del concurso/certamen
  sponsors         String?              // Auspiciadores, patrocinadores y marcas colaboradoras (JSON o texto)
  organizers       String?              // Organizadores, director de certamen, DJ anfitrión (JSON o texto)
  activeStageId       String?              // ID de la fecha/gala activa
  requireConsumption Boolean               @default(true) // Exigir consumo mínimo verificado para votar
  minConsumptionNotes String?               // Ej: "$5.000 o 1 Trago"
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  stages              ContestStage[]
  criteria            ContestCriteria[]
  judges              ContestJudge[]
  participants        ContestParticipant[]
  performances        ContestPerformance[]
  tableConsumptions   ContestTableConsumption[]

  @@index([tenantId])
  @@index([code])
  @@index([status])
}

// 16. ContestStage (Fechas / Galas del concurso para soporte multidía)
model ContestStage {
  id           String               @id @default(cuid())
  contestId    String
  contest      KaraokeContest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  title        String               // Ej: "Gala 1: Eliminatorias", "Gala 2: Semifinal", "Gran Final"
  stageType    String               @default("QUALIFIERS") // AUDITIONS, QUALIFIERS, SEMIFINALS, FINALS
  date         DateTime             @default(now())
  status       String               @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED
  orderIndex   Int                  @default(0)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  performances ContestPerformance[]

  @@index([contestId])
  @@index([status])
}

// 17. ContestCriteria (Criterios de evaluación configurables)
model ContestCriteria {
  id          String         @id @default(cuid())
  contestId   String
  contest     KaraokeContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name        String         // Ej: "Afinación", "Ritmo y Métrica", "Presencia Escénica"
  description String?
  maxScore    Int            @default(10) // Puntuación máxima (ej. 10, 20, 100)
  weight      Float          @default(1.0) // Ponderación
  orderIndex  Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contestId])
  @@index([active])
}

// 18. ContestJudge (Jurados del certamen con acceso por PIN móvil)
model ContestJudge {
  id              String              @id @default(cuid())
  contestId       String
  contest         KaraokeContest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name            String
  title           String?             // Ej: "Vocal Coach", "Jurado de Honor", "Músico Profesional"
  avatarUrl       String?
  accessPin       String              // PIN de 4 dígitos para login móvil instantáneo
  canGoldenBuzzer Boolean             @default(true)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  scores          ContestJudgeScore[]

  @@unique([contestId, accessPin])
  @@index([contestId])
  @@index([accessPin])
}

// 19. ContestParticipant (Cantantes / Participantes inscritos)
model ContestParticipant {
  id           String               @id @default(cuid())
  contestId    String
  contest      KaraokeContest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  name         String
  stageName    String?              // Nombre artístico
  photoUrl     String?
  phone        String?
  email        String?
  tableLabel   String?              // Mesa asignada en el local
  status       String               @default("ACTIVE") // ACTIVE, QUALIFIED, ELIMINATED, WINNER
  finalRank    Int?                 // 1, 2, 3...
  bio          String?
  totalPoints  Float                @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  performances ContestPerformance[]

  @@index([contestId])
  @@index([status])
}

// 20. ContestPerformance (Actuación en una fecha concreta)
model ContestPerformance {
  id             String               @id @default(cuid())
  contestId      String
  contest        KaraokeContest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  stageId        String
  stage          ContestStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participantId  String
  participant    ContestParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  songTitle      String
  artistName     String
  youtubeVideoId String?
  fileUrl        String?
  orderIndex     Int                  @default(0)
  status         String               @default("PENDING") // PENDING, ON_STAGE, VOTING_OPEN, VOTING_CLOSED, REVEALED
  judgeScore     Float                @default(0) // Promedio o suma de jurados
  publicScore    Float                @default(0) // Promedio de voto popular (1-10 o porcentaje)
  totalScore     Float                @default(0) // Calificación ponderada final
  isGoldenBuzzer Boolean              @default(false)
  goldenBuzzerBy String?              // Nombre del jurado que dio el Pase de Oro
  rankPosition   Int?                 // Posición de la fecha
  notes          String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  judgeScores    ContestJudgeScore[]
  publicVotes    ContestPublicVote[]

  @@index([contestId])
  @@index([stageId])
  @@index([participantId])
  @@index([status])
}

// 21. ContestJudgeScore (Voto y desglose de un juez por actuación)
model ContestJudgeScore {
  id            String             @id @default(cuid())
  performanceId String
  performance   ContestPerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  judgeId       String
  judge         ContestJudge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  breakdown     String             // JSON string: { [criteriaId]: number }
  totalScore    Float              // Puntaje calculado para esta actuación
  feedbackNotes String?            // Comentario o devolución del juez
  isGoldenBuzzer Boolean           @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([performanceId, judgeId])
  @@index([performanceId])
  @@index([judgeId])
}

// 22. ContestPublicVote (Votación popular desde las mesas)
model ContestPublicVote {
  id                String             @id @default(cuid())
  performanceId     String
  performance       ContestPerformance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  guestSessionToken String?
  tableLabel        String?
  stars             Int                @default(5) // 1 a 5 estrellas
  cheerCount        Int                @default(0)
  isSuperVote       Boolean            @default(false) // Súper Voto por consumo especial
  voteWeight        Float              @default(1.0)   // Multiplicador (1.0 o 2.0)
  ipAddress         String?
  createdAt         DateTime           @default(now())

  @@index([performanceId])
  @@index([guestSessionToken])
}

// 23. ContestTableConsumption (Estado de consumo y súper votos por mesa)
model ContestTableConsumption {
  id                String         @id @default(cuid())
  contestId         String
  contest           KaraokeContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  tableLabel        String         // "Mesa 1", "Mesa 4", etc.
  status            String         @default("PENDING") // PENDING, VERIFIED, SUPER_VOTE
  consumptionAmount Float          @default(0)
  notes             String?        // "Balde de Cerveza Corona", "$15.000", etc.
  verifiedBy        String?        // "Mozo Juan", "Caja", "DJ"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([contestId, tableLabel])
  @@index([contestId])
  @@index([tableLabel])
}

// =================================================================
// MÓDULO ENTERPRISE: GESTIÓN DE EVENTOS, ACREDITACIONES Y CONTROL DE ACCESO QR
// =================================================================

// 24. EventDay (Jornadas / Días del evento para eventos multidía)
model EventDay {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayNumber      Int             @default(1)
  name           String          // Ej: "Día 1 - Apertura y Conferencias", "Jornada 2"
  date           DateTime
  startTime      String?         // "08:00"
  endTime        String?         // "20:00"
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  checkInRecords CheckInRecord[]

  @@unique([eventId, dayNumber])
  @@index([eventId])
  @@index([date])
}

// 25. EventOrganization (Empresas, Instituciones y Delegaciones)
model EventOrganization {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String             // Nombre de la empresa o delegación
  rucOrTaxId  String?            // RUC / CIF / Identificador tributario
  contactName String?
  email       String?
  phone       String?
  country     String?            @default("Paraguay")
  city        String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  participants EventParticipant[]

  @@index([tenantId])
  @@index([eventId])
  @@index([name])
}

// 26. CredentialTemplate (Diseño y formato visual de credenciales)
model CredentialTemplate {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String?             // Si es null, plantilla global de la empresa
  event              Event?              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name               String              // Ej: "Gafete Oficial A6", "PVC VIP CR80", "Pulsera Térmica"
  format             String              @default("VERTICAL_A6") // VERTICAL_A6, HORIZONTAL_BADGE, PVC_CR80, THERMAL_LABEL, WRISTBAND
  widthMm            Float               @default(100)
  heightMm           Float               @default(150)
  orientation        String              @default("PORTRAIT") // PORTRAIT, LANDSCAPE
  
  backgroundColor    String              @default("#FFFFFF")
  headerColor        String              @default("#080F1F")
  accentColor        String              @default("#3B82F6")
  textColor          String              @default("#0F172A")
  
  showLogo           Boolean             @default(true)
  logoUrl            String?
  showPhoto          Boolean             @default(true)
  showQrCode         Boolean             @default(true)
  showCategoryBadge  Boolean             @default(true)
  showCompany        Boolean             @default(true)
  showJobTitle       Boolean             @default(true)
  showEventName      Boolean             @default(true)
  showDates          Boolean             @default(true)
  showDocument       Boolean             @default(false)
  
  customStyles       String?             // JSON con márgenes, fuentes y coordenadas personalizadas
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  accreditationTypes AccreditationType[]

  @@index([tenantId])
  @@index([eventId])
}

// 27. AccreditationType (Tipos y Categorías de Acreditación)
model AccreditationType {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name               String              // "VIP", "PRENSA", "STAFF", "ORGANIZADOR", "EXPOSITOR", etc.
  code               String              // "VIP", "PRESS", "STAFF", "EXPO"
  description        String?
  colorHex           String              @default("#3B82F6") // Color identificador en la credencial
  textColorHex       String              @default("#FFFFFF")
  maxAvailable       Int?                // Cupos máximos (null = ilimitado)
  validFrom          DateTime?
  validUntil         DateTime?
  allowedStartTime   String?             // "08:00"
  allowedEndTime     String?             // "22:00"
  maxCheckInsPerDay  Int?                // Máximo de ingresos por día (null = ilimitado, 1 = solo un ingreso)
  allowReentry       Boolean             @default(true) // Permite reingreso
  templateId         String?             // Plantilla de credencial vinculada
  template           CredentialTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orderIndex         Int                 @default(0)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  participants       EventParticipant[]
  accreditations     EventAccreditation[]
  accessRules        AccessPointRule[]

  @@unique([eventId, code])
  @@index([tenantId])
  @@index([eventId])
  @@index([code])
}

// 28. EventParticipant (Participantes registrados para el evento)
model EventParticipant {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId             String
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        EventOrganization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accreditationTypeId String?
  accreditationType   AccreditationType?  @relation(fields: [accreditationTypeId], references: [id], onDelete: SetNull)
  
  firstName           String
  lastName            String
  documentNumber      String              // Cédula, Pasaporte o DNI
  documentType        String              @default("CI") // CI, PASSPORT, DNI, RUC
  company             String?             // Nombre de empresa/institución (texto directo o delegación)
  jobTitle            String?             // Cargo o posición
  email               String
  phone               String?
  whatsapp            String?
  country             String?             @default("Paraguay")
  city                String?
  photoUrl            String?
  notes               String?
  isSpecialGuest      Boolean             @default(false)
  customData          String?             // JSON para campos dinámicos
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  accreditation       EventAccreditation?
  checkInRecords      CheckInRecord[]

  @@unique([eventId, documentNumber])
  @@index([tenantId])
  @@index([eventId])
  @@index([email])
  @@index([documentNumber])
  @@index([lastName, firstName])
}

// 29. EventAccreditation (Credenciales emitidas con tokens QR únicos y firmas criptográficas)
model EventAccreditation {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId             String
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId       String            @unique
  participant         EventParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  accreditationTypeId String
  accreditationType   AccreditationType @relation(fields: [accreditationTypeId], references: [id], onDelete: Restrict)
  
  codeNumber          String            @unique // Ej: "EVT-VIP-0042"
  qrToken             String            @unique // Token único UUID/CUID no predecible
  qrSignature         String            // Firma HMAC-SHA256 para verificación rápida y anti-falsificación
  qrCodeUrl           String?           // Imagen DataURL o URL del QR
  
  status              String            @default("APPROVED") // PENDING, APPROVED, ACCREDITED, CHECKED_IN, REJECTED, CANCELLED, BLOCKED
  rejectionReason     String?
  
  issuedAt            DateTime?         @default(now())
  issuedBy            String?           // Nombre del usuario u operador que emitió
  accreditedAt        DateTime?         // Momento de entrega física de la credencial
  firstCheckInAt      DateTime?
  lastCheckInAt       DateTime?
  totalCheckIns       Int               @default(0)
  
  printCount          Int               @default(0)
  lastPrintedAt       DateTime?
  lastPrintedBy       String?
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  checkInRecords      CheckInRecord[]

  @@index([tenantId])
  @@index([eventId])
  @@index([qrToken])
  @@index([status])
  @@index([codeNumber])
}

// 30. AccessPoint (Puertas, Sectores y Accesos del Evento)
model AccessPoint {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name               String            // "Entrada Principal", "Acceso VIP", "Prensa & Backstage"
  code               String            // "GATE_1", "VIP_ACCESS", "BACKSTAGE"
  locationDetails    String?           // "Puerta 3 - Acceso Norte"
  sectorType         String            @default("MAIN") // MAIN, VIP, PRESS, BACKSTAGE, STAFF, VENDOR
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  rules              AccessPointRule[]
  checkInRecords     CheckInRecord[]
  scannerDevices     ScannerDevice[]

  @@unique([eventId, code])
  @@index([tenantId])
  @@index([eventId])
  @@index([code])
}

// 31. AccessPointRule (Matriz de permisos: qué categorías pueden entrar por qué puerta)
model AccessPointRule {
  id                  String            @id @default(cuid())
  accessPointId       String
  accessPoint         AccessPoint       @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  accreditationTypeId String
  accreditationType   AccreditationType @relation(fields: [accreditationTypeId], references: [id], onDelete: Cascade)
  isAllowed           Boolean           @default(true)
  allowedTimeStart    String?           // "08:00"
  allowedTimeEnd      String?           // "20:00"
  createdAt           DateTime          @default(now())

  @@unique([accessPointId, accreditationTypeId])
  @@index([accessPointId])
  @@index([accreditationTypeId])
}

// 32. CheckInRecord (Historial inmutable de escaneos y accesos)
model CheckInRecord {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accreditationId     String
  accreditation       EventAccreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  participantId       String
  participant         EventParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  accessPointId       String?
  accessPoint         AccessPoint?       @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  eventDayId          String?
  eventDay            EventDay?          @relation(fields: [eventDayId], references: [id], onDelete: SetNull)
  
  direction           String             @default("IN") // IN, OUT
  status              String             // APPROVED, REJECTED, DUPLICATE, PENDING
  rejectionReason     String?            // "ALREADY_CHECKED_IN", "INVALID_SECTOR", "OUT_OF_SCHEDULE", "BLOCKED", "INVALID_QR"
  
  scannedAt           DateTime           @default(now())
  operatorId          String?            // ID de usuario operador
  operatorName        String?            // Nombre del operador
  deviceIdentifier    String?            // ID o descripción del dispositivo escáner
  
  isOfflineRecord     Boolean            @default(false)
  syncedAt            DateTime?          // Fecha en que se sincronizó si fue offline
  notes               String?
  
  @@index([tenantId])
  @@index([eventId])
  @@index([accreditationId])
  @@index([participantId])
  @@index([accessPointId])
  @@index([status])
  @@index([scannedAt])
}

// 33. ScannerDevice (Dispositivos móviles y estaciones de escaneo autorizadas)
model ScannerDevice {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessPointId      String?
  accessPoint        AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  name               String       // "Móvil Puerta 1", "Tablet VIP", "Láser Acceso A"
  deviceToken        String       @unique // Token para autenticar el dispositivo de escaneo rápido
  assignedToUser     String?      // Nombre del operador asignado
  status             String       @default("ACTIVE") // ACTIVE, INACTIVE, REVOKED
  lastActiveAt       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([deviceToken])
}

// 34. ReservationPackage (Paquetes, combos de cumpleaños y camarotes)
model ReservationPackage {
  id                    String              @id @default(cuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId               String?
  venue                 Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  name                  String              // Ej: "Combo Cumpleaños Gold", "Camarote Ultra VIP"
  description           String?
  imageUrl              String?             // Foto del paquete / portada
  itemsIncluded         String              // JSON string: array de strings de artículos incluidos
  
  // Modalidad Financiera:
  // CLEAN_FEE: Alquiler limpio/puro (no se descuenta de consumo)
  // CREDIT_CONSUMPTION: 100% o monto acreditable a favor en consumición
  // FIXED_COMBO: Paquete cerrado con bebidas y productos predefinidos
  pricingType           String              @default("PACKAGE") 
  priceCents            Int                 @default(0)
  creditAmountCents     Int                 @default(0) // Saldo a favor si es CREDIT_CONSUMPTION
  
  maxGuests             Int                 @default(8)
  isBirthdayPackage     Boolean             @default(false)
  allowScreenShoutout   Boolean             @default(true) // Proyecta saludo y foto en la TV
  colorHex              String              @default("#8B5CF6")
  active                Boolean             @default(true)
  orderIndex            Int                 @default(0)
  
  decorations           DecorationOption[]
  reservations          TableReservation[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([active])
}

// 35. DecorationOption (Opciones de decoración con fotos para que el cliente elija)
model DecorationOption {
  id                    String              @id @default(cuid())
  tenantId              String
  packageId             String
  package               ReservationPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name                  String              // Ej: "Decoración Neón Glow", "Elegance Dorado & Negro", "Rosas & Champagne"
  description           String?
  imageUrl              String              // Foto real de la decoración
  extraPriceCents       Int                 @default(0) // 0 si está incluida sin cargo adicional
  active                Boolean             @default(true)
  orderIndex            Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  reservations          TableReservation[]

  @@index([tenantId])
  @@index([packageId])
}

// 36. TableReservation (Reserva oficial de mesa o camarote)
model TableReservation {
  id                    String              @id @default(cuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId               String
  venue                 Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId               String
  table                 Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  packageId             String?
  package               ReservationPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  decorationId          String?
  decoration            DecorationOption?   @relation(fields: [decorationId], references: [id], onDelete: SetNull)
  eventId               String?
  event                 Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Cliente Titular
  customerName          String
  customerPhone         String              // WhatsApp
  customerEmail         String?
  customerDoc           String?
  
  // Opciones especiales de Cumpleaños / Celebración
  birthdayPersonName    String?             // Nombre del homenajeado para la pantalla gigante
  birthdayPhotoUrl      String?             // Foto del cumpleañero para proyectar en TV
  specialNotes          String?             // Solicitudes especiales

  // Modalidad y Finanzas
  pricingType           String              // CLEAN_FEE, CREDIT_CONSUMPTION, FIXED_COMBO
  totalAmountCents      Int
  creditAmountCents     Int                 @default(0) // Saldo a favor acreditable en mesa
  creditRemainingCents  Int                 @default(0) // Saldo restante por consumir
  
  // Pago
  paymentMethod         String              @default("TRANSFER") // TRANSFER, CARD_ONLINE, QR_PAGOS, CASH_DOOR
  paymentStatus         String              @default("PENDING") // PENDING, PENDING_REVIEW, APPROVED, REJECTED, REFUNDED
  paymentProofUrl       String?             // Comprobante de transferencia bancaria
  paymentRef            String?
  verifiedByUserId      String?             // ID del usuario staff que aprobó
  verifiedAt            DateTime?

  // Estado de la Reserva
  status                String              @default("PENDING") // PENDING, CONFIRMED, CHECKED_IN, CANCELLED
  reservationDate       DateTime
  checkInTime           DateTime?

  // Pases de Amigos / Invitados
  inviteToken           String              @unique // Token para compartir pases por WhatsApp
  maxGuests             Int                 @default(8)
  guests                ReservationGuest[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([tableId])
  @@index([packageId])
  @@index([reservationDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([inviteToken])
}

// 37. ReservationGuest (Pases individuales para acompañantes del camarote)
model ReservationGuest {
  id                    String              @id @default(cuid())
  reservationId         String
  reservation           TableReservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  
  guestName             String
  guestDoc              String?
  guestPhone            String?
  qrToken               String              @unique
  checkedIn             Boolean             @default(false)
  checkedInAt           DateTime?
  
  createdAt             DateTime            @default(now())

  @@index([reservationId])
  @@index([qrToken])
}

// =================================================================
// MÓDULO INTEGRAL: GESTIÓN GASTRONÓMICA, POS, KDS (BARRA / COCINA / MOZOS),
// CAJA, SEÑAS, INVENTARIO Y BANDEJA CENTRAL DE FACTURACIÓN
// =================================================================

// 38. GastroSector (Sectores físicos del establecimiento)
model GastroSector {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String   // Salón principal, Barra, Terraza, VIP, Discoteca, Camarotes, Patio, Reservados
  code        String   // SALON, BARRA, TERRAZA, VIP, DISCO, CAMAROTES, PATIO, RESERVADOS
  description String?
  colorHex    String   @default("#8B5CF6")
  orderIndex  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables      Table[]

  @@unique([venueId, code])
  @@index([tenantId])
  @@index([venueId])
  @@index([active])
}

// 39. GastroCategory (Categorías del Menú Digital)
model GastroCategory {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?          @relation(fields: [venueId], references: [id], onDelete: SetNull)
  name        String          // Cervezas, Bebidas, Tragos, Cócteles, Vinos, Comidas, Hamburguesas, Pizzas, Picadas, Postres, Promociones, Productos especiales
  slug        String
  description String?
  iconName    String?         @default("Utensils")
  imageUrl    String?
  destination String          @default("BAR") // BAR, KITCHEN, BOTH
  orderIndex  Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  products    GastroProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([venueId])
  @@index([active])
  @@index([orderIndex])
}

// 40. GastroProduct (Productos del Menú vinculados al Inventario)
model GastroProduct {
  id                 String                  @id @default(cuid())
  tenantId           String
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId            String?
  venue              Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  categoryId         String
  category           GastroCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  code               String                  // Código SKU / Interno (ej: BEB-001, HAM-002)
  name               String                  // Ej: "Cerveza Munich 500 ml", "Hamburguesa especial"
  description        String?
  imageUrl           String?
  presentation       String?                 // Ej: "Botella 500 ml", "Pinta 473 ml", "Porción 350g"
  
  priceCents         Int                     // Precio de venta
  costCents          Int                     @default(0) // Costo
  currency           String                  @default("PYG") // PYG (Gs.), USD, ARS
  
  stockQuantity      Float                   @default(100)
  minStockQuantity   Float                   @default(10)
  unit               String                  @default("UN") // UN, ML, LT, GR, KG, PORCION
  trackInventory     Boolean                 @default(true)
  hasRecipe          Boolean                 @default(false) // Si true, descuenta de GastroProductRecipeItem
  
  // Destino operativo: BAR (Barra), KITCHEN (Cocina), BOTH (Ambos)
  destination        String                  @default("BAR")
  
  // Estado de disponibilidad diferenciado (Fase 10):
  // AVAILABLE, MANUAL_DISABLED, AUTO_EXHAUSTED, MISSING_INGREDIENTS, TEMPORARILY_UNAVAILABLE
  availabilityStatus String                  @default("AVAILABLE")
  active             Boolean                 @default(true)
  isFeatured         Boolean                 @default(false)
  isPromotion        Boolean                 @default(false)
  
  // Opciones adicionales configurables (JSON array: [{ id, name, priceCents }])
  // Ej: [{ "id": "queso", "name": "Queso extra", "priceCents": 5000 }, { "id": "panceta", "name": "Panceta", "priceCents": 8000 }]
  optionsJson        String?
  
  // Auditoría de quién desactivó o agotó el producto y cuándo
  disabledByUserId   String?
  disabledByName     String?
  disabledByRole     String?
  disabledAt         DateTime?
  disabledReason     String?

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  recipeItems        GastroProductRecipeItem[]
  orderItems         GastroOrderItem[]
  inventoryMovements GastroInventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([venueId])
  @@index([categoryId])
  @@index([destination])
  @@index([availabilityStatus])
  @@index([active])
}

// 41. GastroInventoryItem (Insumos e Ingredientes de Inventario para Recetas y Stock)
model GastroInventoryItem {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId          String?
  venue            Venue?                    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  code             String                    // INS-PAN, INS-CARNE, INS-QUESO
  name             String                    // Pan de Hamburguesa, Medallón de Carne 180g, Queso Cheddar, Panceta, Verduras
  category         String                    @default("INGREDIENT") // INGREDIENT, BEVERAGE, PACKAGING, OTHER
  unit             String                    @default("UN") // UN, GR, KG, ML, LT
  currentStock     Float                     @default(0)
  minStock         Float                     @default(10)
  costPerUnitCents Int                       @default(0)
  active           Boolean                   @default(true)
  lastRestockedAt  DateTime?
  lastRestockedBy  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  recipeUsages     GastroProductRecipeItem[]
  movements        GastroInventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([venueId])
  @@index([active])
}

// 42. GastroProductRecipeItem (Relación Receta: Producto -> Ingredientes)
model GastroProductRecipeItem {
  id              String              @id @default(cuid())
  productId       String
  product         GastroProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   GastroInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityRequired Float              @default(1) // Cantidad que descuenta por 1 unidad vendida
  optional        Boolean             @default(false)
  createdAt       DateTime            @default(now())

  @@unique([productId, inventoryItemId])
  @@index([productId])
  @@index([inventoryItemId])
}

// 43. GastroInventoryMovement (Kardex de movimientos de stock)
model GastroInventoryMovement {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId         String?
  venue           Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  productId       String?
  product         GastroProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  inventoryItemId String?
  inventoryItem   GastroInventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  
  movementType    String               // SALE_DEDUCTION, RESTOCK, MANUAL_ADJUSTMENT, WASTE, CANCEL_RESTORE, STOCK_ALERT
  quantityDelta   Float                // Negativo para descuento, positivo para reposición
  previousStock   Float
  newStock        Float
  reason          String?
  orderId         String?
  performedById   String?
  performedByName String?
  performedByRole String?
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([inventoryItemId])
  @@index([movementType])
  @@index([createdAt])
}

// 44. GastroDeliveryConfig (Configuración operativa de Entrega: Retiro en Barra vs Entrega por Mozo - Fase 3)
model GastroDeliveryConfig {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId               String   @unique
  venue                 Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  
  barPickupEnabled      Boolean  @default(true)  // Opción 1: Retiro en barra
  waiterDeliveryEnabled Boolean  @default(true)  // Opción 2: Entrega por mozo
  defaultDeliveryMode   String   @default("WAITER_DELIVERY") // BAR_PICKUP, WAITER_DELIVERY
  serviceFeeCents       Int      @default(0)     // Costo fijo de servicio o entrega por mozo
  serviceFeePercent     Float    @default(0)     // Porcentaje opcional de servicio
  
  requirePaymentBeforePrep Boolean @default(true) // Si true, efectivo/tarjeta/QR debe confirmarse antes de preparar
  allowKitchenDirectDeliveryException Boolean @default(false) // Excepción de admin para que cocina cierre sin mozo
  currency              String   @default("PYG")
  
  updatedByUserId       String?
  updatedByName         String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@index([venueId])
}

// 45. GastroTableSession (Sesión de consumo / Cuenta de Mesa para transferencia, unificación y división)
model GastroTableSession {
  id                  String        @id @default(cuid())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId             String
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId             String
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  
  sessionCode         String        @unique // Código corto visible al cliente (ej: SES-M4-8912)
  status              String        @default("OPEN") // OPEN, PENDING_PAYMENT, CLOSED, TRANSFERRED, MERGED
  customerName        String?
  customerTaxId       String?       // RUC / CI para facturación
  guestCount          Int           @default(2)
  assignedWaiterId    String?
  assignedWaiterName  String?
  
  subtotalCents       Int           @default(0)
  discountCents       Int           @default(0)
  serviceFeeCents     Int           @default(0)
  depositAppliedCents Int           @default(0)
  totalCents          Int           @default(0)
  paidCents           Int           @default(0)
  balanceCents        Int           @default(0)
  
  // División de cuentas (JSON array con subcuentas por cliente/persona si se divide)
  splitAccountsJson   String?
  notes               String?
  
  openedAt            DateTime      @default(now())
  closedAt            DateTime?
  updatedAt           DateTime      @updatedAt

  orders              GastroOrder[]
  payments            GastroPayment[]
  deposits            GastroCustomerDeposit[]

  @@index([tenantId])
  @@index([venueId])
  @@index([tableId])
  @@index([status])
  @@index([sessionCode])
}

// 46. GastroOrder (Pedido Gastronómico Integral: Cliente / Mozo / Caja -> Barra & Cocina -> Mozo)
model GastroOrder {
  id                     String              @id @default(cuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId                String
  venue                  Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId                String?
  table                  Table?              @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSessionId         String?
  tableSession           GastroTableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  guestSessionId         String?
  
  orderNumber            String              // Número único legible (ej: PED-000105)
  tableNumber            Int?
  tableLabel             String              // Ej: "Mesa 4"
  sectorName             String              @default("Salón Principal")
  sessionCode            String?
  customerName           String?
  customerPhone          String?
  customerTaxId          String?
  
  // Modalidad de entrega (Fase 3): BAR_PICKUP (Retiro en barra) | WAITER_DELIVERY (Entrega por mozo)
  deliveryMode           String              @default("WAITER_DELIVERY")
  priority               String              @default("NORMAL") // NORMAL, HIGH, VIP
  
  // Banderas de ruteo según ítems solicitados
  hasBarItems            Boolean             @default(false)
  hasKitchenItems        Boolean             @default(false)
  
  // Estado general del pedido:
  // RECEIVED, PENDING_PAYMENT, PAYMENT_CONFIRMED, PREPARING, READY, WAITING_PICKUP, WAITING_WAITER, DELIVERED, CANCELLED
  status                 String              @default("RECEIVED")
  
  // Estado específico en Panel de Barra (Fase 4):
  // NONE, RECEIVED, PENDING_PAYMENT, PAYMENT_CONFIRMED, PREPARING, READY, WAITING_PICKUP, WAITING_WAITER, DELIVERED, CANCELLED
  barStatus              String              @default("NONE")
  
  // Estado específico en Panel de Cocina (Fase 5):
  // NONE, RECEIVED, PENDING_PAYMENT, PAYMENT_CONFIRMED, PREPARING, READY, REQUESTING_WAITER, DELIVERED, CANCELLED
  kitchenStatus          String              @default("NONE")
  
  // Estado de Pago (Fase 7):
  // PENDING, PROCESSING, APPROVED, REJECTED, EXPIRED, REFUNDED, PARTIALLY_PAID
  paymentStatus          String              @default("PENDING")
  paymentMethodSelected  String              @default("CASH") // CASH, DEBIT_CARD, CREDIT_CARD, BANK_TRANSFER, QR_PAYMENT, PIX, DEPOSIT, PARTIAL
  
  // Importes
  subtotalCents          Int                 @default(0)
  discountCents          Int                 @default(0)
  discountAuthorizedBy   String?
  serviceFeeCents        Int                 @default(0)
  depositAppliedCents    Int                 @default(0)
  totalCents             Int                 @default(0)
  paidCents              Int                 @default(0)
  currency               String              @default("PYG")
  
  notes                  String?
  cancelReason           String?
  cancelledByName        String?
  
  // Control de Mozos y Despacho (Fase 6) - Concurrencia controlada
  waiterRequestStatus    String              @default("NONE") // NONE, REQUESTED, ACCEPTED, PICKED_UP_BAR, PICKED_UP_KITCHEN, DELIVERED
  assignedWaiterId       String?
  assignedWaiterName     String?
  waiterRequestedAt      DateTime?
  waiterAcceptedAt       DateTime?
  pickedUpFromBarAt      DateTime?
  pickedUpFromKitchenAt  DateTime?
  deliveredAt            DateTime?
  deliveredByName        String?
  waiterNotes            String?             // Inconvenientes o rechazos justificados
  rejectionLogsJson      String?             // Historial de rechazos justificados por mozos
  
  // Timestamps de trazabilidad operativa
  receivedAt             DateTime            @default(now())
  paymentConfirmedAt     DateTime?
  prepStartedAt          DateTime?
  readyAt                DateTime?
  cancelledAt            DateTime?
  updatedAt              DateTime            @updatedAt

  items                  GastroOrderItem[]
  payments               GastroPayment[]
  pendingInvoiceSale     GastroPendingInvoiceSale?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([venueId])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([status])
  @@index([barStatus])
  @@index([kitchenStatus])
  @@index([paymentStatus])
  @@index([waiterRequestStatus])
  @@index([assignedWaiterId])
  @@index([receivedAt])
}

// 47. GastroOrderItem (Ítems individuales dentro de un Pedido)
model GastroOrderItem {
  id                  String        @id @default(cuid())
  orderId             String
  order               GastroOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             GastroProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  productCode         String
  productName         String
  presentation        String?
  destination         String        @default("BAR") // BAR, KITCHEN, BOTH
  
  quantity            Int           @default(1)
  unitPriceCents      Int
  extrasPriceCents    Int           @default(0)
  subtotalCents       Int
  
  // Adicionales seleccionados (JSON array: [{ id, name, priceCents }])
  selectedOptionsJson String?
  // Observaciones específicas del producto (ej: "bien fría", "sin cebolla")
  observations        String?
  
  itemStatus          String        @default("PENDING") // PENDING, PREPARING, READY, DELIVERED, CANCELLED
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([destination])
}

// 48. GastroPayment (Transacciones de Pago en Caja y Pagos Digitales QR / PIX / Tarjetas - Fase 7)
model GastroPayment {
  id                  String                   @id @default(cuid())
  tenantId            String
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId             String
  venue               Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orderId             String?
  order               GastroOrder?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tableSessionId      String?
  tableSession        GastroTableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  shiftId             String?
  shift               GastroCashRegisterShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  transactionCode     String                   @unique // Identificador único de transacción (ej: PAY-2026-00912)
  orderNumber         String?
  
  // Método: CASH, DEBIT_CARD, CREDIT_CARD, BANK_TRANSFER, QR_PAYMENT, PIX, DEPOSIT_APPLICATION
  paymentMethod       String
  // Modalidad: FULL (Pago total), PARTIAL (Pago parcial), DEPOSIT (Pago de seña)
  paymentModality     String                   @default("FULL")
  
  amountCents         Int
  receivedAmountCents Int?                     // Importe recibido en efectivo para cálculo de vuelto
  changeAmountCents   Int?                     @default(0)
  currency            String                   @default("PYG")
  
  // Proveedor de pago: CAJA_LOCAL, POS_BANCARD, SIPAP_QR, PIX_PROVIDER, STRIPE, MERCADOPAGO
  provider            String                   @default("CAJA_LOCAL")
  providerReference   String?                  // Referencia de transacción del banco / POS / QR (NUNCA guardar PAN ni CVV)
  cardBrand           String?                  // VISA, MASTERCARD, CABAL (solo marca y últimos 4 opcional, sin PAN ni CVV)
  cardLast4           String?
  
  // Datos QR / PIX interoperable
  qrPayload           String?                  // EMVCo / QR payload generado para el pedido
  qrImageUrl          String?
  qrExpiresAt         DateTime?
  webhookSignature    String?                  // Firma HMAC validada del webhook del proveedor
  webhookVerified     Boolean                  @default(false)
  
  // Estados: PENDING, PROCESSING, APPROVED, REJECTED, EXPIRED, REFUNDED, PARTIALLY_PAID
  status              String                   @default("PENDING")
  rejectionReason     String?
  
  cashierUserId       String?
  cashierName         String?
  confirmedAt         DateTime?
  refundedAt          DateTime?
  refundReason        String?
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([orderId])
  @@index([tableSessionId])
  @@index([shiftId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
}

// 49. GastroCustomerDeposit (Sistema de Señas y Reservas - Fase 8)
model GastroCustomerDeposit {
  id                     String              @id @default(cuid())
  tenantId               String
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId                String
  venue                  Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId                String?
  table                  Table?              @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSessionId         String?
  tableSession           GastroTableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  reservationId          String?             // Vinculable a TableReservation existente
  eventId                String?
  
  receiptNumber          String              @unique // Comprobante único (ej: SEN-00045)
  customerName           String
  customerPhone          String?
  customerTaxId          String?
  
  // Cálculo de seña: porcentaje o importe fijo
  depositType            String              @default("FIXED") // PERCENTAGE, FIXED
  estimatedConsumptionCents Int              @default(0) // Ej: Gs. 500.000
  depositPercentage      Float?              // Ej: 30%
  depositAmountCents     Int                 // Ej: Gs. 150.000
  appliedAmountCents     Int                 @default(0) // Monto ya aplicado al consumo final
  remainingCreditCents   Int                 // Saldo de seña disponible para aplicar
  pendingConsumptionBalanceCents Int         @default(0) // Ej: Gs. 350.000 saldo estimado pendiente
  currency               String              @default("PYG")
  
  paymentMethod          String              @default("BANK_TRANSFER") // CASH, DEBIT_CARD, CREDIT_CARD, BANK_TRANSFER, QR_PAYMENT, PIX
  paymentReference       String?
  
  // Estado: PENDING, CONFIRMED, PARTIALLY_APPLIED, APPLIED_TO_CONSUMPTION, REFUNDED, CANCELLED
  status                 String              @default("CONFIRMED")
  isDefinitiveSale       Boolean             @default(false) // Siempre false en seña pura para no duplicar ingresos al aplicar
  
  registeredByUserId     String?
  registeredByName       String?
  depositDate            DateTime            @default(now())
  appliedAt              DateTime?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([tableId])
  @@index([status])
  @@index([depositDate])
}

// 50. GastroCashRegisterShift (Cierre de Caja por Turno y Operador - Fase 15)
model GastroCashRegisterShift {
  id                    String          @id @default(cuid())
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId               String
  venue                 Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  
  shiftCode             String          @unique // Ej: TURNO-20261109-01
  shiftName             String          @default("Turno Noche") // Turno Tarde, Turno Noche, Madrugada
  cashierUserId         String
  cashierName           String
  
  status                String          @default("OPEN") // OPEN, CLOSED
  openingCashCents      Int             @default(0)
  
  // Totales acumulados durante el turno
  cashSalesCents        Int             @default(0)
  debitCardSalesCents   Int             @default(0)
  creditCardSalesCents  Int             @default(0)
  transferSalesCents    Int             @default(0)
  qrSalesCents          Int             @default(0)
  pixSalesCents         Int             @default(0)
  depositsReceivedCents Int             @default(0)
  refundsCents          Int             @default(0)
  totalSalesCents       Int             @default(0)
  
  expectedCashCents     Int             @default(0)
  countedCashCents      Int?
  differenceCents       Int?            @default(0)
  
  openedAt              DateTime        @default(now())
  closedAt              DateTime?
  closedByName          String?
  closingNotes          String?

  payments              GastroPayment[]

  @@index([tenantId])
  @@index([venueId])
  @@index([cashierUserId])
  @@index([status])
  @@index([openedAt])
}

// 51. GastroPendingInvoiceSale (Bandeja Central: VENTAS PENDIENTES DE FACTURACIÓN - Fase 11)
model GastroPendingInvoiceSale {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venueId              String
  venue                Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orderId              String       @unique
  order                GastroOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  
  saleNumber           String       @unique // Número de venta comercial (ej: VTA-000105)
  sourceUniqueId       String       @unique // Identificador único inmutable de origen (idempotencia anti-duplicación)
  orderNumber          String
  
  saleDate             DateTime     @default(now())
  tableLabel           String
  sectorName           String
  customerName         String       @default("Consumidor Final")
  customerTaxId        String       @default("44444401-7") // RUC / Documento para facturación fiscal
  customerEmail        String?
  
  // Detalle inmutable de productos, cantidades, precios y descuentos (JSON)
  itemsSnapshotJson    String
  
  subtotalCents        Int
  discountCents        Int          @default(0)
  serviceFeeCents      Int          @default(0)
  depositAppliedCents  Int          @default(0)
  totalCents           Int
  currency             String       @default("PYG")
  
  paymentMethod        String
  paymentReference     String?
  
  // Estados obligatorios (Fase 11):
  // PENDING_INVOICING (Pendiente de facturación)
  // SENT_TO_MAIN_SYSTEM (Enviado al sistema principal)
  // INVOICED (Facturado)
  // INTEGRATION_ERROR (Error de integración)
  // VOIDED (Anulado)
  invoicingStatus      String       @default("PENDING_INVOICING")
  
  // Trazabilidad de integración con el Sistema Principal / Fiscal
  batchGroupId         String?      // Si se facturó de forma agrupada
  externalInvoiceId    String?      // ID devuelto por el ERP / Sistema Principal
  fiscalDocumentNumber String?      // Ej: "001-001-0045892"
  syncAttempts         Int          @default(0)
  lastSyncAt           DateTime?
  lastErrorLog         String?
  syncHistoryJson      String?      // Historial inmutable de envíos, respuestas y conciliación
  
  invoicedByUserId     String?
  invoicedByName       String?
  invoicedAt           DateTime?
  voidedReason         String?
  voidedByName         String?
  voidedAt             DateTime?
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([tenantId])
  @@index([venueId])
  @@index([invoicingStatus])
  @@index([saleDate])
  @@index([batchGroupId])
}




